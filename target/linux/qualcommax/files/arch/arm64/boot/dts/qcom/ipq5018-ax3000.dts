/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Xiaomi AX3000";
	compatible = "xiaomi,ax3000", "qcom,ipq5018";

	aliases {
		ethernet0 = &dp2;
		ethernet1 = &dp1;

		led-boot = &led_system_blue;
		led-failsafe = &led_system_yellow;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;

		serial0 = &blsp1_uart1;
	};

	chosen {
		// bootargs = "console=ttyMSM0,115200n8 init=/bin/sh loglevel=7";
		bootargs-append = " coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: system-blue {
			label = "led_blue";
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_system_yellow: system-yellow {
			label = "led_yellow";
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_net_blue: net-blue {
			label = "net_blue";
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_net_yellow: net-yellow {
			label = "net_yellow";
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		/*
		led_phy: led-phy {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		*/
	};
};

&q6_region {
	reg = <0x00 0x4b000000 0x00 0x3400000>;
};

&{/thermal-zones} {
    status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 { status = "okay"; };
&crypto { status = "okay"; };
&cryptobam { status = "okay"; };
&prng { status = "okay"; };
&qfprom { status = "okay"; };
&qpic_bam { status = "okay"; };

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nandcs@0 {
		compatible = "qcom,nandcs";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <0x200>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 { label = "0:SBL1"; reg = <0x00000000 0x00080000>; read-only; };
			partition@80000 { label = "0:MIBIB"; reg = <0x00080000 0x00080000>; read-only; };
			partition@100000 { label = "0:BOOTCONFIG"; reg = <0x00100000 0x00040000>; read-only; };
			partition@140000 { label = "0:BOOTCONFIG1"; reg = <0x00140000 0x00040000>; read-only; };
			partition@180000 { label = "0:QSEE"; reg = <0x00180000 0x00100000>; read-only; };
			partition@280000 { label = "0:QSEE_1"; reg = <0x00280000 0x00100000>; read-only; };
			partition@380000 { label = "0:DEVCFG"; reg = <0x00380000 0x00040000>; read-only; };
			partition@3c0000 { label = "0:DEVCFG_1"; reg = <0x003c0000 0x00040000>; read-only; };
			partition@400000 { label = "0:CDT"; reg = <0x00400000 0x00040000>; read-only; };
			partition@440000 { label = "0:CDT_1"; reg = <0x00440000 0x00040000>; read-only; };
			partition@480000 { label = "0:APPSBLENV"; reg = <0x00480000 0x00080000>; };
			partition@500000 { label = "0:APPSBL"; reg = <0x00500000 0x00140000>; read-only; };
			partition@640000 { label = "0:APPSBL_1"; reg = <0x00640000 0x00140000>; read-only; };
			partition@780000 {
				label = "0:ART";
				reg = <0x00780000 0x00100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;
					mac_addr_dp1: macaddr@0 { reg = <0x0 0x6>; };
					mac_addr_dp2: macaddr@6 { reg = <0x6 0x6>; };
					/* caldata for IPQ5018: dd skip=4096 count=131072 */
					caldata_ipq5018: caldata@1000 { reg = <0x1000 0x20000>;};
		            /* caldata for QCN6122: dd skip=157696(154KiB) count=131072 */
					caldata_qcn6122: caldata@26800 { reg = <0x26800 0x20000>; };
				};
			};
			partition@880000 { label = "0:TRAINING"; reg = <0x00880000 0x00080000>; read-only; };
			partition@900000 { label = "bdata"; reg = <0x00900000 0x00080000>; };
			partition@980000 { label = "crash"; reg = <0x00980000 0x00080000>; };
			partition@a00000 { label = "crash_syslog"; reg = <0x00a00000 0x00080000>; };
			partition@a80000 { label = "rootfs"; reg = <0x00a80000 0x06700000>; };
			/*
			partition@a80000 { label = "rootfs"; reg = <0x00a80000 0x02400000>; };
			partition@2e80000 { label = "rootfs_1"; reg = <0x02e80000 0x02400000>; };
			partition@5280000 { label = "overlay"; reg = <0x05280000 0x01f00000>; };
			partition@7180000 { label = "rsvd0"; reg = <0x07180000 0x00080000>; };
			*/
		};
	};
};

&switch  {
	status = "okay";
	compatible = "qcom,ess-switch-ipq50xx";
	device_id = <0>;
	cmnblk_clk = "internal_96MHz";
	reg = <0x39c00000 0x200000>;
	switch_mac_mode = <0x0f>;
	switch_access_mode = "local bus";
	/*
	clocks = <0x03 0x28 0x03 0x29 0x03 0x86 0x03 0x88 0x03 0x47 0x03 0x48 0x03 0x37 0x03 0x3a 0x03 0x3c 0x03 0x3f 0x03 0x35 0x03 0x36 0x03 0x87 0x03 0x89 0x03 0x39 0x03 0x3b 0x03 0x3e 0x03 0x40 0x03 0x6e 0x03 0x70 0x03 0x38 0x03 0x3d>;
	clock-names = "cmn_ahb_clk", "cmn_sys_clk", "uniphy_ahb_clk", "uniphy_sys_clk", "gcc_mdio0_ahb_clk", "gcc_mdio1_ahb_clk", "gcc_gmac0_cfg_clk", "gcc_gmac0_sys_clk", "gcc_gmac1_cfg_clk", "gcc_gmac1_sys_clk", "uniphy0_port1_rx_clk", "uniphy0_port1_tx_clk", "uniphy1_port5_rx_clk", "uniphy1_port5_tx_clk", "nss_port1_rx_clk", "nss_port1_tx_clk", "nss_port2_rx_clk", "nss_port2_tx_clk", "gcc_snoc_gmac0_ahb_clk", "gcc_snoc_gmac1_ahb_clk", "gcc_gmac0_ptp_clk", "gcc_gmac1_ptp_clk";
	
	resets = <0x03 0x11 0x03 0x5d 0x03 0x16 0x03 0x19 0x03 0x6e 0x03 0x6f>;
	reset-names = "gephy_bcr_rst", "uniphy_bcr_rst", "gmac0_bcr_rst", "gmac1_bcr_rst", "uniphy1_soft_rst", "gephy_misc_rst";
	*/
	qcom,port_phyinfo {
		port@0 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
			phy_dac = <0x10 0x10>;
		};
		port@1 {
			port_id = <2>;
			forced-speed = <1000>;
			forced-duplex = <1>;
		};
		/*
		led_source@0 {
			source = <0>;
			mode = "normal";
			speed = "all";
			blink_en = "enable";
			active = "low";
		};
		*/
	};
};

&ess_instance {
	status = "okay";
	num_devices = <2>;

	ess-switch1@1 {
		compatible = "qcom,ess-switch-qca83xx";
		device_id = <1>;
		switch_access_mode = "mdio";
		mdio-bus = <&mdio1>;
		reset_gpio = <&tlmm 26 GPIO_ACTIVE_HIGH>;
		switch_cpu_bmp = <0x60>;
		switch_acpu_bmp = <0x60>;
		switch_lan_bmp = <0x0e>;
		switch_wan_bmp = <0x10>;
		qca,ar8327-initvals = <0x04 0x7600000 0x08 0x1000000 0x0c 0x80 0x10 0x2613a0 0xe4 0xaa545 0xe0 0xc74164de 0x7c 0x4e 0x94 0x4e>;
		
		qcom,port_phyinfo {
			port@1 { port_id = <1>; phy_address = <0>; };
			port@2 { port_id = <2>; phy_address = <1>; };
			port@3 { port_id = <3>; phy_address = <2>; };
			port@4 { port_id = <4>; phy_address = <3>; };
			port@5 { port_id = <5>; phy_address = <4>; };
			port@6 {
				port_id = <6>;
				forced-speed = <1000>;
				forced-duplex = <1>;
			};
		};		
	};
};

&dp1 {
	status = "okay";
	device_type = "network";
	compatible = "qcom,nss-dp";
	clocks = <&gcc GCC_SNOC_GMAC0_AXI_CLK>;
	clock-names = "nss-snoc-gmac-axi-clk";
	qcom,id = <0x01>;
	reg = <0x39c00000 0x10000>;
	interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
	qcom,mactype = <0x02>;
	qcom,link-poll = <0x01>;
	qcom,phy-mdio-addr = <0x07>;
	nvmem-cells = <&mac_addr_dp1>;
	nvmem-cell-names = "mac-address";
	phy-handle = <&wan_phy>;
	phy-mode = "sgmii";
	mdio-bus = <&mdio0>;
};

&dp2 {
	status = "okay";
	device_type = "network";
	compatible = "qcom,nss-dp";
	clocks = <&gcc GCC_SNOC_GMAC1_AXI_CLK>;
	clock-names = "nss-snoc-gmac-axi-clk";
	qcom,id = <0x02>;
	reg = <0x39d00000 0x10000>;
	interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
	qcom,mactype = <0x02>;
	nvmem-cells = <&mac_addr_dp2>;
	nvmem-cell-names = "mac-address";
	phy-mode = "sgmii";
	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio0 {
	status = "okay";
	wan_phy: ethernet-phy@7 { reg = <0x07>; };		
};

&mdio1 {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	phy-reset-gpio = <&tlmm 26 GPIO_ACTIVE_HIGH>;
	ethernet-phy@0 { reg = <0x0>; };
	ethernet-phy@1 { reg = <0x1>; };
	ethernet-phy@2 { reg = <0x2>; };
	ethernet-phy@3 { reg = <0x3>; };
	ethernet-phy@4 { reg = <0x4>; };
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio25", "gpio23";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-pins {
		led_blue {
			pins = "gpio19";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_yellow {
			pins = "gpio17";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		net_blue {
			pins = "gpio22";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		net_yellow {
			pins = "gpio20";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};
		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};
		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};
};

/* disabled due to ath11k_pci not support QCN6102
//pci@a0000000
&pcie0_phy { status = "disabled"; };
&pcie0 {
    status = "disabled";
    perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;
};

//pci@80000000
&pcie1_phy { status = "disabled"; };
&pcie1 {
    status = "disabled";
    perst-gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
};
*/

&q6v5_wcss {
	status = "okay";
	qcom,multipd_arch;
	qcom,share_bootargs;
	qcom,q6v6;
	qcom,bootargs_smem = <507>;
	 /* rec2: type=2, len=4, upd=2, reset-gpio=27 */
	boot-args = <2 4 2 27 0 0>; 
	memory-region = <&q6_region>;
};

&q6_wcss_pd1 {
	status = "disabled";
	memory-region = <&q6_region>;
};

&q6_wcss_pd2 {
	status = "okay";
	memory-region = <&q6_region>;
};

&q6_wcss_pd3 {
	status = "disabled";
};

&wifi {
	// IPQ5018
	status = "disabled";
	qcom,multipd_arch;
	qcom,userpd = <1>;
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,board_id = <0x10>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
	qcom,ath11k-calibration-variant = "Xiaomi-AX3000-2G";

	/* caldata from 0:ART nvmem-layout */
	nvmem-cells = <&caldata_ipq5018>;
	nvmem-cell-names = "calibration";
};

&wifi1 {
	// QCN6102
	status = "okay";
	qcom,multipd_arch;
	qcom,userpd = <2>;
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,board_id = <0x50>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4d300000>;
	qcom,ath11k-calibration-variant = "Xiaomi-AX3000-5G";

	/* caldata from 0:ART nvmem-layout */
	nvmem-cells = <&caldata_qcn6122>;
	nvmem-cell-names = "calibration";
};


